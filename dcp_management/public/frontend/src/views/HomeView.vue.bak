<script setup>
import { ref, onMounted, onUnmounted } from 'vue';
import { useRouter } from 'vue-router';
import { api } from '@/api';

const router = useRouter();
const showEligibilityModal = ref(false);
const consentGiven = ref(false);
const scrollCheck = ref(0);

const proceedToOnboard = () => {
    if (consentGiven.value) {
      router.push('/onboard');
    }
};

// Animate checklist on scroll
const handleScroll = () => {
  const scrollY = window.scrollY;
  const vh = window.innerHeight;
  if (scrollY > vh * 0.3) scrollCheck.value = 1;
  if (scrollY > vh * 0.45) scrollCheck.value = 2;
  if (scrollY > vh * 0.6) scrollCheck.value = 3;
};

onMounted(async () => {
  window.addEventListener('scroll', handleScroll);
  try {
    const res = await api.get('/api/method/dcp_management.api.get_current_user_customer');
    if (res.message && res.message.customer) {
      const customer = res.message.customer;
      if (customer.kyc_status !== 'Incomplete') {
        router.push({ name: 'dashboard' });
      }
    }
  } catch (error) {
    console.log('User not authenticated or no customer record');
  }
});

onUnmounted(() => {
  window.removeEventListener('scroll', handleScroll);
});
</script>
