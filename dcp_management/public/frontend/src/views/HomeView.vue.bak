          </label>
        </div>

        <button @click="proceedToOnboard" :disabled="!consentGiven"
          class="btn-primary w-full text-center disabled:opacity-30 disabled:cursor-not-allowed disabled:shadow-none">
          Proceed to Verification
        </button>
      </div>
    </div>

    <!-- FOOTER -->
    <footer class="bg-white text-ink-black border-t-2 border-ink-black py-12">
